# Copy to .env and fill in a key. Docker Compose reads this file for substitution.
# LLM_PROVIDER=anthropic uses the Anthropic Java SDK.
# LLM_PROVIDER=openai posts to OPENAI_BASE_URL, which can be any OpenAI-compatible server.

LLM_PROVIDER=anthropic

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

LLM_MAX_TOKENS=8192
